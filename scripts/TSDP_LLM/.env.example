# Paths
DATA_DIR=./data
BOOKS_DIR=./data/books
QDRANT_PATH=./data/qdrant_db
COLLECTION_NAME=football_knowledge

# Embedding Model (FastEmbed)
# Options: BAAI/bge-small-en-v1.5, sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_MODEL_NAME=BAAI/bge-small-en-v1.5

# Local LLM (Ollama)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b

# OpenRouter Free LLM (Comma-separated keys for automatic rotation)
# Register at openrouter.ai to generate free API keys
OPENROUTER_API_KEYS=sk-or-v1-key1,sk-or-v1-key2
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free
# Alternative free models: google/gemini-2.0-flash-lite:free, qwen/qwen-2.5-72b-instruct:free, openrouter/free
